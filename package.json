{
  "name": "mcp-shield",
  "version": "0.1.0",
  "description": "Zero-overhead runtime security proxy, secret vault, and audit firewall for Model Context Protocol (MCP) servers",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mcp-shield": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "tsc && node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "mcp-shield",
    "model-context-protocol",
    "ai-security",
    "guardrails",
    "firewall",
    "audit",
    "secret-redaction",
    "claude-desktop",
    "cursor"
  ],
  "author": "Alex Fraser and mcp-shield contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alexfraser-scotch/mcp-shield"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "type": "module"
}
